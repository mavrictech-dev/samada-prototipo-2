{
  "name": "samada-commerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "local:configure": "node scripts/configure-local.mjs",
    "services": "docker compose -f compose.local.yml -p samada-commerce up -d --wait",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker": "tsx scripts/worker.ts",
    "test:integration": "tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@tailwindcss/postcss": "latest",
    "better-auth": "^1.7.11",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "latest",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.5",
    "tailwindcss": "latest",
    "zod": "^4.6.7"
  },
  "overrides": { "exceljs": { "uuid": "^11.1.1" } },
  "devDependencies": {
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv": "^18.0.8",
    "eslint": "latest",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "latest"
  }
}
