POSTGRES_PASSWORD=CAMBIAR
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERAR_CON_OPENSSL_RAND_HEX_32
TRUSTED_ORIGINS=http://localhost:3000
SMTP_HOST=127.0.0.1
MAIL_TRANSPORT=smtp-local
SMTP_PORT=2526
SMTP_SECURE=false
MAIL_FROM=Samada <acceso@samada.local>
