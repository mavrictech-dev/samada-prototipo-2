# Copiar como /var/www/samada/.env y editar en el servidor. No guardar secretos en Git.
POSTGRES_PASSWORD=CAMBIAR_POR_OPENSSL_RAND_HEX_32
BETTER_AUTH_SECRET=CAMBIAR_POR_OTRO_OPENSSL_RAND_HEX_32
BETTER_AUTH_URL=https://gestion.samadaperu.com
TRUSTED_ORIGINS=https://gestion.samadaperu.com,https://samadaperu.com,https://www.samadaperu.com
SMTP_HOST=CAMBIAR_POR_SERVIDOR_SMTP
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CAMBIAR_POR_USUARIO_SMTP
SMTP_PASSWORD=CAMBIAR_POR_PASSWORD_SMTP
MAIL_FROM="Samada <acceso@samadaperu.com>"
# DATABASE_URL lo configura docker-compose.yml con host db y POSTGRES_PASSWORD.
