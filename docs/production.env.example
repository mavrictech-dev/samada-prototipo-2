# Copiar como /var/www/samada/.env y editar en el servidor. No guardar secretos en Git.
POSTGRES_PASSWORD=CAMBIAR_POR_OPENSSL_RAND_HEX_32
BETTER_AUTH_SECRET=CAMBIAR_POR_OTRO_OPENSSL_RAND_HEX_32
BETTER_AUTH_URL=https://gestion.samadaperu.com
TRUSTED_ORIGINS=https://gestion.samadaperu.com,https://samadaperu.com,https://www.samadaperu.com
MAIL_TRANSPORT=gmail-api
GOOGLE_MAIL_USER=CAMBIAR_POR_BUZON_AUTORIZADO
GOOGLE_OAUTH_CLIENT_ID=CAMBIAR_POR_CLIENTE_GOOGLE
GOOGLE_OAUTH_CLIENT_SECRET=CAMBIAR_POR_SECRETO_GOOGLE
GOOGLE_OAUTH_REFRESH_TOKEN=CAMBIAR_POR_TOKEN_OFFLINE
# MAIL_FROM es opcional: por defecto Samada <GOOGLE_MAIL_USER>.
# Para SMTP OAuth con permiso amplio aprobado: MAIL_TRANSPORT=gmail-oauth-smtp.
# No se requiere SMTP_PASSWORD con OAuth.
# DATABASE_URL lo configura docker-compose.yml con host db y POSTGRES_PASSWORD.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
